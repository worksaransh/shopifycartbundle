{%- comment -%}
  Bundle block (product page). Server-rendered from the product metafield `bundles`; bundlekit-bundle.js adds variant
  selection, live price display and add-to-cart. Prices here are an ESTIMATE: the discount Function decides at checkout.
  Renders NOTHING if config is missing, kill switch on, a component product cannot be found, or no real saving exists.
  AMOUNT / FIXED_PRICE bundles are stored in the shop currency, so they are skipped for carts in another currency.
{%- endcomment -%}
{%- liquid
  assign cfg = shop.metafields['$app:bundlekit'].config.value
  assign data = product.metafields['$app:bundlekit'].bundles.value
  assign today = 'now' | date: '%Y%m%d' | plus: 0
-%}
{%- if cfg.killSwitch != true and data.bundles != blank -%}
  {%- for bundle in data.bundles -%}
    {%- liquid
      assign skip = false
      if bundle.startsAt != blank
        assign s = bundle.startsAt | remove: '-' | plus: 0
        if today < s
          assign skip = true
        endif
      endif
      if bundle.endsAt != blank
        assign e = bundle.endsAt | remove: '-' | plus: 0
        if today > e
          assign skip = true
        endif
      endif
      if bundle.discountType != 'PERCENT' and cart.currency.iso_code != shop.currency
        assign skip = true
      endif
      assign original = 0
      assign broken = false
      assign soldout = false
    -%}
    {%- if skip -%}{%- continue -%}{%- endif -%}

    {%- capture items_html -%}
      {%- if bundle.type == 'FIXED' -%}
        {%- for c in bundle.components -%}
          {%- assign p = all_products[c.handle] -%}
          {%- if p == blank or p.empty -%}
            {%- assign broken = true -%}
            {%- break -%}
          {%- endif -%}
          {%- assign dv = p.selected_or_first_available_variant | default: p.variants.first -%}
          {%- assign line = dv.price | times: c.quantity -%}
          {%- assign original = original | plus: line -%}
          {%- unless dv.available -%}{%- assign soldout = true -%}{%- endunless -%}
          <li class="bk-item" data-bk-item data-product-id="gid://shopify/Product/{{ p.id }}" data-quantity="{{ c.quantity }}">
            {%- if p.featured_image -%}
              <img class="bk-img" src="{{ p.featured_image | image_url: width: 128 }}" alt="" width="64" height="64" loading="lazy">
            {%- else -%}
              <span class="bk-img" aria-hidden="true"></span>
            {%- endif -%}
            <span class="bk-name">{% if c.quantity > 1 %}{{ c.quantity }} × {% endif %}{{ p.title | escape }}</span>
            {%- if p.variants.size > 1 -%}
              <select class="bk-var" data-bk-variant aria-label="{{ p.title | escape }}">
                {%- for v in p.variants -%}
                  <option value="{{ v.id }}" data-price="{{ v.price }}" data-available="{{ v.available }}" {% if v.id == dv.id %}selected{% endif %}>{{ v.title | escape }}{% unless v.available %} (sold out){% endunless %}</option>
                {%- endfor -%}
              </select>
            {%- else -%}
              <input type="hidden" data-bk-variant value="{{ dv.id }}" data-price="{{ dv.price }}" data-available="{{ dv.available }}">
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign coll = collections[bundle.components.first.handle] -%}
        {%- if coll == blank or coll.empty -%}{%- assign broken = true -%}{%- endif -%}
        {%- for p in coll.products limit: 12 -%}
          {%- assign dv = p.selected_or_first_available_variant | default: p.variants.first -%}
          <li class="bk-item" data-bk-pick data-product-id="gid://shopify/Product/{{ p.id }}">
            <span class="bk-name">{{ p.title | escape }}</span>
            <input type="hidden" data-bk-variant value="{{ dv.id }}" data-price="{{ dv.price }}" data-available="{{ dv.available }}">
            <label class="bk-sr" for="bk-q-{{ bundle.id }}-{{ p.id }}">{{ p.title | escape }}</label>
            <input id="bk-q-{{ bundle.id }}-{{ p.id }}" type="number" min="0" max="{{ bundle.components.first.quantity }}" value="0" inputmode="numeric" data-bk-qty {% unless dv.available %}disabled{% endunless %}>
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if broken -%}{%- continue -%}{%- endif -%}

    {%- liquid
      assign saved = 0
      if bundle.type == 'FIXED'
        if bundle.discountType == 'PERCENT'
          assign saved = original | times: bundle.discountValue | plus: 50 | divided_by: 100
        elsif bundle.discountType == 'AMOUNT'
          assign v = bundle.discountValue | plus: 0
          assign saved = v
          if saved > original
            assign saved = original
          endif
        else
          assign v = bundle.discountValue | plus: 0
          assign saved = original | minus: v
          if saved < 0
            assign saved = 0
          endif
        endif
        if saved <= 0
          continue
        endif
      endif
      assign now_price = original | minus: saved
    -%}

    <div class="bk-card bk-layout-{{ block.settings.layout }}" data-bk-bundle
      data-bundle-id="{{ bundle.id }}" data-type="{{ bundle.type }}"
      data-discount-type="{{ bundle.discountType }}" data-discount-value="{{ bundle.discountValue }}"
      data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}"
      {%- if bundle.type == 'MIX_MATCH' %} data-need="{{ bundle.components.first.quantity }}" data-collection-id="{{ bundle.components.first.collectionId }}"{% endif %}
      data-beacon="/apps/bundlekit/event"
      {% if block.settings.accent != blank %}style="--color-button:{{ block.settings.accent }}"{% endif %} {{ block.shopify_attributes }}>
      <h3 class="bk-title">{{ block.settings.heading | default: bundle.title | escape }}</h3>
      {%- if bundle.badge != blank -%}<span class="bk-badge">{{ bundle.badge | escape }}</span>{%- endif -%}
      <ul class="bk-items {% if bundle.type == 'MIX_MATCH' %}bk-mix{% endif %}">{{ items_html }}</ul>
      {%- if bundle.type == 'MIX_MATCH' -%}
        <p>{{ bundle.components.first.quantity }} × <span data-bk-count>0/{{ bundle.components.first.quantity }}</span></p>
      {%- endif -%}
      <p class="bk-price">
        <span class="bk-label">{%- assign s = cfg.strings['bundle.price'] -%}{%- if s != blank -%}{{ s }}{%- else -%}{{ 'bundle.price' | t }}{%- endif -%}</span>
        {%- if bundle.type == 'FIXED' -%}
          <s class="bk-was" data-bk-original>{{ original | money }}</s>
          <strong class="bk-now" data-bk-now>{{ now_price | money }}</strong>
        {%- else -%}
          <s class="bk-was" data-bk-original></s> <strong class="bk-now" data-bk-now></strong>
        {%- endif -%}
        <span class="bk-save" data-bk-save></span>
      </p>
      <p class="bk-note">{{ 'price.atCheckout' | t }}</p>
      <p class="bk-note" data-bk-note>{% if soldout %}{{ 'bundle.soldOut' | t }}{% endif %}</p>
      <button type="button" class="bk-add" data-bk-add {% if soldout or bundle.type == 'MIX_MATCH' %}disabled{% endif %}>
        {%- assign s = cfg.strings['bundle.add'] -%}{%- if s != blank -%}{{ s }}{%- else -%}{{ 'bundle.add' | t }}{%- endif -%}
      </button>
      <script type="application/json" data-bk-strings>{{ cfg.strings | json }}</script>
    </div>
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "Bundle",
  "target": "section",
  "stylesheet": "bundlekit.css",
  "javascript": "bundlekit-bundle.js",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the bundle title." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "card", "options": [{ "value": "card", "label": "Card" }, { "value": "compact", "label": "Compact" }] },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Leave empty to use your theme's button colour." }
  ]
}
{% endschema %}
